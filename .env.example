# Public origin of this application, used by server-side metadata such as Open Graph images.
# Production: replace with the deployed origin. Do not include a path.
# APP_URL=https://<subdomain>.hvanexus.trinhpb.site
APP_URL=http://localhost:3000

# ==============================================================================
# API GATEWAY
# ==============================================================================

# Base URL của API Gateway — chỉ dùng server-side (trong API Route proxy).
# Không được expose ra client vì chứa internal endpoint.
APIGATEWAY_BASE_URL=https://apigateway.hvanexus.trinhpb.site/

# Prefix path của từng service trong API Gateway.
# Client sẽ gọi qua proxy: /api/proxy/<service>/<endpoint>
NEXT_PUBLIC_APIGATEWAY_IAM=iam
NEXT_PUBLIC_APIGATEWAY_HRM_EM=hrm-em
NEXT_PUBLIC_APIGATEWAY_FTM=ftm
NEXT_PUBLIC_APIGATEWAY_PLM=plm

# Bypass gateway — trỏ thẳng vào service đang chạy local.
# Chỉ tác dụng server-side; client vẫn qua proxy nhưng proxy sẽ forward
# thẳng tới URL này (bỏ prefix gateway) thay vì qua APIGATEWAY_BASE_URL.
# Để trống = đi qua gateway như bình thường. Chỉ dùng cho dev.
# FTM_DIRECT_URL=http://localhost:8080/
# IAM_DIRECT_URL=http://localhost:8081/
# HRMEM_DIRECT_URL=http://localhost:8082/
# PLM_DIRECT_URL=http://localhost:8083/

# ==============================================================================
# API PROXY (Next.js Route Handler)
# ==============================================================================

# Base URL của API proxy nội bộ Next.js (/api/proxy/...).
# Client gọi qua đây để Next.js server thêm Authorization header trước khi
# forward sang APIGATEWAY_BASE_URL — tránh expose token ra browser.
# Production: thay bằng subdomain thực tế.
# NEXT_PUBLIC_APIPROXY_BASE_URL=https://<subdomain>.hvanexus.trinhpb.site/api/proxy/
NEXT_PUBLIC_APIPROXY_BASE_URL=http://localhost:3000/api/proxy/

# ==============================================================================
# NEXTAUTH (Authentication)
# ==============================================================================

# Secret key dùng để ký và mã hóa JWT session token của NextAuth.
# Tạo giá trị mới: openssl rand -base64 32
NEXTAUTH_SECRET=cJm9b1H7xQeTzK4YvW2uN8rLpA6sDfGhIjKlMnOpQr0=

# URL callback của NextAuth sau khi đăng nhập.
# Production: thay bằng URL thực của subdomain.
# NEXTAUTH_URL=https://<subdomain>.hvanexus.trinhpb.site/sign-in
NEXTAUTH_URL=http://localhost:3000/sign-in

# Domain cho cookie session NextAuth.
# Dùng .hvanexus.trinhpb.site (có dấu chấm đầu) để cookie dùng chung
# giữa các subdomain trong hệ thống micro-frontend.
# NEXTAUTH_COOKIE_DOMAIN=.hvanexus.trinhpb.site
NEXTAUTH_COOKIE_DOMAIN=localhost

# ==============================================================================
# PUBLIC APP CONFIG
# ==============================================================================

# URL trang đăng nhập — dùng để redirect khi chưa authenticated.
# Production: thay bằng URL sign-in của portal chính.
# NEXT_PUBLIC_SIGNIN_URL=https://hvanexus.trinhpb.site/sign-in
NEXT_PUBLIC_SIGNIN_URL=http://localhost:3000/sign-in

# Base URL của Web Shared Remote (Module Federation) chứa các shared component.
# Production: trỏ vào remote host đang serve shared bundle.
# NEXT_PUBLIC_WEB_SHARED_REMOTE_BASE_URL=http://localhost:3008/
NEXT_PUBLIC_WEB_SHARED_REMOTE_BASE_URL=https://shared-remote.hvanexus.trinhpb.site/

# Định danh của app này trong hệ thống micro-frontend HVA Nexus.
# Dùng để lọc menu, phân quyền theo app trong App Switcher.
NEXT_PUBLIC_APP_KEY=platform-management

# Khi true, App Switcher chỉ hiển thị app hiện tại và không cho chuyển app.
NEXT_PUBLIC_SINGLE_APP=false

# Bật/tắt mock API (MSW). Khi true, request không gửi lên server thật.
# Chỉ dùng cho local development và demo — không đặt true trên production.
NEXT_PUBLIC_MOCK_API=true

# ==============================================================================
# NPM (Private Registry)
# ==============================================================================

# Token xác thực npm để pull private package @hva-nexus/* từ registry nội bộ.
# Cần thiết khi build Docker qua --mount=type=secret,id=npmrc
# NPM_TOKEN=
